diff --git a/core/tests/pub_stalled_subscriber.rs b/core/tests/pub_stalled_subscriber.rs
new file mode 100644
index 0000000..38128e1
--- /dev/null
+++ b/core/tests/pub_stalled_subscriber.rs
@@ -0,0 +1,116 @@
+//! A PUB never blocks on a subscriber that stopped reading (ZMQ RFC 29, libzmq): once that
+//! subscriber's queue is full it misses messages, and the other subscribers keep receiving.
+//! With the default SNDTIMEO the PUB used to wait on the full subscriber instead (30 s per
+//! message on io_uring sessions), stalling every subscriber behind the slowest one.
+
+mod common;
+
+use rzmq::socket::options::{LAST_ENDPOINT, LINGER, RCVHWM, SNDHWM, SUBSCRIBE};
+use rzmq::{Msg, Socket, SocketType};
+use serial_test::serial;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+const MESSAGES: u64 = 20_000;
+const SIZE: usize = 1024;
+const SEND_DEADLINE: Duration = Duration::from_secs(15);
+
+async fn endpoint_of(socket: &Socket) -> String {
+  String::from_utf8(socket.get_option(LAST_ENDPOINT).await.unwrap()).unwrap()
+}
+
+async fn set_i32(socket: &Socket, option: i32, value: i32) {
+  socket.set_option_raw(option, &value.to_ne_bytes()).await.unwrap();
+}
+
+async fn run(uring: bool) {
+  #[cfg(not(feature = "io-uring"))]
+  if uring {
+    return;
+  }
+  let ctx = common::test_context();
+  let publ = ctx.socket(SocketType::Pub).unwrap();
+  let fast = ctx.socket(SocketType::Sub).unwrap();
+  let stalled = ctx.socket(SocketType::Sub).unwrap();
+  for s in [&publ, &fast, &stalled] {
+    set_i32(s, LINGER, 0).await;
+    #[cfg(feature = "io-uring")]
+    if uring {
+      set_i32(s, rzmq::socket::options::IO_URING_SESSION_ENABLED, 1).await;
+    }
+  }
+  set_i32(&publ, SNDHWM, 100).await;
+  set_i32(&stalled, RCVHWM, 10).await;
+  publ.bind("tcp://127.0.0.1:0").await.unwrap();
+  let ep = endpoint_of(&publ).await;
+  for s in [&fast, &stalled] {
+    s.set_option_raw(SUBSCRIBE, b"").await.unwrap();
+    s.connect(&ep).await.unwrap();
+  }
+  tokio::time::sleep(Duration::from_millis(500)).await; // subscriptions reach the PUB
+
+  let received = Arc::new(AtomicU64::new(0));
+  let last_seq = Arc::new(AtomicU64::new(0));
+  let reader = tokio::spawn({
+    let fast = fast.clone();
+    let received = received.clone();
+    let last_seq = last_seq.clone();
+    async move {
+      while let Ok(msg) = fast.recv().await {
+        let seq = u64::from_be_bytes(msg.data().unwrap()[..8].try_into().unwrap());
+        received.fetch_add(1, Ordering::Relaxed);
+        last_seq.store(seq, Ordering::Relaxed);
+      }
+    }
+  });
+
+  // `stalled` never reads. The whole send loop must finish without waiting on it.
+  let started = Instant::now();
+  let send_all = async {
+    for seq in 0..MESSAGES {
+      let mut data = vec![0u8; SIZE];
+      data[..8].copy_from_slice(&seq.to_be_bytes());
+      publ.send(Msg::from_vec(data)).await.unwrap();
+      if seq % 256 == 0 {
+        tokio::task::yield_now().await; // let the fast reader keep up
+      }
+    }
+  };
+  tokio::time::timeout(SEND_DEADLINE, send_all)
+    .await
+    .unwrap_or_else(|_| panic!("PUB blocked on the stalled subscriber (uring={uring})"));
+  let send_time = started.elapsed();
+
+  // The fast subscriber got traffic well past the point where the stalled one filled up,
+  // including (after a short drain) messages from the end of the run.
+  let drain_until = Instant::now() + Duration::from_secs(5);
+  while last_seq.load(Ordering::Relaxed) < MESSAGES - 1 && Instant::now() < drain_until {
+    tokio::time::sleep(Duration::from_millis(20)).await;
+  }
+  let got = received.load(Ordering::Relaxed);
+  assert!(
+    last_seq.load(Ordering::Relaxed) >= MESSAGES * 9 / 10,
+    "fast subscriber stalled at seq {} of {MESSAGES} (uring={uring}, received {got}, sends took {send_time:?})",
+    last_seq.load(Ordering::Relaxed)
+  );
+  reader.abort();
+  ctx.term().await.unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn pub_does_not_block_on_stalled_subscriber_tokio() {
+  run(false).await;
+}
+
+#[cfg(feature = "io-uring")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn pub_does_not_block_on_stalled_subscriber_uring() {
+  if rzmq::uring::initialize_uring_backend(rzmq::uring::UringConfig::default()).is_err() {
+    eprintln!("io_uring not available, skipping");
+    return;
+  }
+  run(true).await;
+}
