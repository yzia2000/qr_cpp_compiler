+/// Payload of a `SendVectoredZc` op (`IORING_OP_SENDMSG_ZC`). The kernel reads the
+/// payload pages until the op's notification CQE (`IORING_CQE_F_NOTIF`), which can come
+/// well after the send's own completion, so everything the `msghdr` points to lives here
+/// until then. `msghdr` and `iovecs` are boxed so their addresses stay fixed while this
+/// struct moves.
+pub(crate) struct ZcEgressBatch {
+  pub msghdr: Box<libc::msghdr>,
+  pub iovecs: Box<[libc::iovec]>,
+  pub payloads: Vec<Bytes>,
+  pub total_len: usize,
+  /// The send's own CQE was processed; only the notification is outstanding.
+  pub sent: bool,
+}
+
+impl ZcEgressBatch {
+  pub fn new(payloads: Vec<Bytes>) -> Self {
+    let total_len = payloads.iter().map(|b| b.len()).sum();
+    let mut iovecs: Box<[libc::iovec]> = payloads
+      .iter()
+      .map(|b| libc::iovec {
+        iov_base: b.as_ptr() as *mut libc::c_void,
+        iov_len: b.len(),
+      })
+      .collect::<Vec<_>>()
+      .into_boxed_slice();
+    // SAFETY: an all-zero msghdr is valid (no name, no control data).
+    let mut msghdr: Box<libc::msghdr> = Box::new(unsafe { std::mem::zeroed() });
+    msghdr.msg_iov = iovecs.as_mut_ptr();
+    msghdr.msg_iovlen = iovecs.len() as _;
+    Self {
+      msghdr,
+      iovecs,
+      payloads,
+      total_len,
+      sent: false,
+    }
+  }
+
+  pub fn msghdr_ptr(&self) -> *const libc::msghdr {
+    &*self.msghdr
+  }
+
+  /// The bytes after the first `written`, as zero-copy slices of the payloads.
+  pub fn remainder_after(&self, written: usize) -> Vec<Bytes> {
+    let mut skip = written;
+    let mut rest = Vec::new();
+    for payload in &self.payloads {
+      if skip >= payload.len() {
+        skip -= payload.len();
+      } else {
+        rest.push(payload.slice(skip..));
+        skip = 0;
+      }
+    }
+    rest
+  }
+}
+
+// SAFETY: the raw pointers in `msghdr`/`iovecs` point into `iovecs`/`payloads`, owned here.
+// Only the worker thread touches the batch between submission and the notification.
+unsafe impl Send for ZcEgressBatch {}
+
