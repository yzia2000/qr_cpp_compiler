+
+/// CQEs of a `SendVectoredZc` op (`IORING_OP_SENDMSG_ZC`). The first CQE reports the send
+/// (and carries `IORING_CQE_F_MORE` when a notification follows); the notification CQE
+/// (`IORING_CQE_F_NOTIF`) says the kernel no longer references the payload pages. The op
+/// stays in the tracker under its `UserData` until then, so the id cannot be recycled while
+/// the kernel still owes a CQE for it.
+fn process_vectored_zc_cqe(
+  worker: &mut UringWorker,
+  cqe_user_data: UserData,
+  cqe_result: i32,
+  cqe_flags: u32,
+  new_work_generated: &mut Vec<(RawFd, Vec<HandlerSqeBlueprint>)>,
+) {
+  if (cqe_flags & CQE_F_NOTIFY_FLAG) != 0 {
+    let copied = (cqe_result as u32) & IORING_NOTIF_USAGE_ZC_COPIED != 0;
+    if let Some(details) = worker.internal_op_tracker.take_op_details(cqe_user_data) {
+      if details.fd >= 0 {
+        if let Some(handler) = worker.handler_manager.get_mut(details.fd) {
+          handler.on_zerocopy_notification(copied);
+        }
+      }
+    }
+    return;
+  }
+
+  let notification_follows = (cqe_flags & IOURING_CQE_F_MORE) != 0;
+  let (handler_fd, total_len, remainder) = {
+    let Some(details) = worker.internal_op_tracker.get_op_details_mut(cqe_user_data) else {
+      return;
+    };
+    let InternalOpPayload::VectoredZc(batch) = &mut details.payload else {
+      unreachable!("SendVectoredZc op without VectoredZc payload");
+    };
+    batch.sent = true;
+    let written = cqe_result.max(0) as usize;
+    let remainder = if written < batch.total_len {
+      batch.remainder_after(written)
+    } else {
+      Vec::new()
+    };
+    (details.fd, batch.total_len, remainder)
+  };
+  if !notification_follows {
+    worker.internal_op_tracker.take_op_details(cqe_user_data);
+  }
+  if handler_fd < 0 {
+    return; // connection already closed
+  }
+
+  if cqe_result < 0 {
+    let errno = -cqe_result;
+    if errno == libc::EAGAIN || errno == libc::EWOULDBLOCK || errno == libc::ENOBUFS {
+      // Retry as a regular writev; the write gate stays held until that completes.
+      counter!(worker.metrics, eagain_errors, inc);
+      worker
+        .work_map
+        .entry(handler_fd)
+        .or_default()
+        .egress_blueprints
+        .push_front(HandlerSqeBlueprint::RequestSendRawVectored {
+          bufs: remainder,
+          send_op_flags: 0,
+          batch_count: 0,
+        });
+      return;
+    }
+    let zmq_err = ZmqError::from(std::io::Error::from_raw_os_error(errno));
+    error!(fd = handler_fd, error = %zmq_err, "Fatal error during SENDMSG_ZC. Closing connection.");
+    worker.fds_needing_close_initiated_pass.push_back(handler_fd);
+    return;
+  }
+
+  if (cqe_result as usize) < total_len {
+    trace!(
+      fd = handler_fd,
+      written = cqe_result,
+      total_len,
+      "SENDMSG_ZC partial: re-queuing remainder as writev."
+    );
+    worker
+      .work_map
+      .entry(handler_fd)
+      .or_default()
+      .egress_blueprints
+      .push_front(HandlerSqeBlueprint::RequestSendRawVectored {
+        bufs: remainder,
+        send_op_flags: 0,
+        batch_count: 0,
+      });
+    return;
+  }
+
+  // Complete: release the handler's write gate exactly like a finished writev.
+  if let Some(handler) = worker.handler_manager.get_mut(handler_fd) {
+    let pending_egress = worker
+      .work_map
+      .get(&handler_fd)
+      .map_or(0, |w| w.egress_blueprints.len());
+    let io_config = handler.io_config().clone();
+    let interface = UringWorkerInterface::new(
+      handler_fd,
+      &io_config,
+      worker.buffer_manager.as_ref(),
+      worker.default_buffer_ring_group_id_val,
+      cqe_user_data,
+      pending_egress,
+      true,
+      worker.cfg_egress_cap,
+    );
+    let handler_output =
+      handler.handle_internal_sqe_completion(cqe_user_data, cqe_result, cqe_flags, &interface);
+    if !handler_output.sqe_blueprints.is_empty() {
+      new_work_generated.push((handler_fd, handler_output.sqe_blueprints));
+    }
+    if handler_output.initiate_close_due_to_error {
+      worker.fds_needing_close_initiated_pass.push_back(handler_fd);
+    }
+  }
+}
