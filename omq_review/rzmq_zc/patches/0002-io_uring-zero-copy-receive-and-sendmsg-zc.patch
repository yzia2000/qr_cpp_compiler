index 0000000..fbfc9f8
--- /dev/null
+++ b/core/tests/io_uring_direct_recv.rs
@@ -0,0 +1,285 @@
+//! io_uring direct (zero-copy) receive: once a connection sees a large frame, frame bodies
+//! are received straight into their message buffer instead of through the provided-buffer
+//! ring (`IO_URING_RCV_DIRECT_THRESHOLD`). These tests check the bytes end to end across the
+//! mode switch, frame sizes on both sides of the ring slot size, the threshold and the
+//! preallocation cap, multipart messages, and peers that vanish in the middle of a frame.
+#![cfg(feature = "io-uring")]
+
+mod common;
+
+use rzmq::socket::options::{
+  IO_URING_RCVMULTISHOT, IO_URING_RCV_DIRECT_THRESHOLD, IO_URING_SESSION_ENABLED, LAST_ENDPOINT,
+  LINGER, RCVHWM, SNDHWM, SUBSCRIBE,
+};
+use rzmq::uring::{initialize_uring_backend, UringConfig};
+use rzmq::{Msg, MsgFlags, Socket, SocketType, ZmqError};
+use serial_test::serial;
+use std::io::{Read, Write};
+use std::net::TcpStream;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Once;
+use std::time::Duration;
+
+static URING_INIT: Once = Once::new();
+static URING_AVAILABLE: AtomicBool = AtomicBool::new(false);
+
+fn init_uring() -> bool {
+  URING_INIT.call_once(|| {
+    match initialize_uring_backend(UringConfig {
+      default_recv_multishot: true,
+      num_workers: 1,
+      ..Default::default()
+    }) {
+      Ok(()) => URING_AVAILABLE.store(true, Ordering::Relaxed),
+      Err(e) => eprintln!("io_uring not available on this system, skipping tests: {}", e),
+    }
+  });
+  URING_AVAILABLE.load(Ordering::Relaxed)
+}
+
+const RECV_TIMEOUT: Duration = Duration::from_secs(20);
+
+/// Deterministic, position- and message-dependent bytes, so misplaced or stale data is caught.
+fn payload(seq: u32, len: usize) -> Vec<u8> {
+  let mut state = 0x9E37_79B9_7F4A_7C15u64 ^ (u64::from(seq) << 32 | len as u64);
+  (0..len)
+    .map(|_| {
+      state ^= state << 13;
+      state ^= state >> 7;
+      state ^= state << 17;
+      state as u8
+    })
+    .collect()
+}
+
+async fn endpoint_of(socket: &Socket) -> String {
+  String::from_utf8(socket.get_option(LAST_ENDPOINT).await.unwrap()).unwrap()
+}
+
+async fn uring_socket(ctx: &rzmq::Context, kind: SocketType, direct_threshold: Option<i32>) -> Socket {
+  let s = ctx.socket(kind).unwrap();
+  s.set_option_raw(IO_URING_SESSION_ENABLED, &1i32.to_ne_bytes()).await.unwrap();
+  s.set_option_raw(IO_URING_RCVMULTISHOT, &1i32.to_ne_bytes()).await.unwrap();
+  s.set_option_raw(SNDHWM, &10_000i32.to_ne_bytes()).await.unwrap();
+  s.set_option_raw(RCVHWM, &10_000i32.to_ne_bytes()).await.unwrap();
+  s.set_option_raw(LINGER, &2_000i32.to_ne_bytes()).await.unwrap();
+  if let Some(t) = direct_threshold {
+    s.set_option_raw(IO_URING_RCV_DIRECT_THRESHOLD, &t.to_ne_bytes()).await.unwrap();
+  }
+  s
+}
+
+async fn recv(socket: &Socket) -> Msg {
+  common::recv_timeout(socket, RECV_TIMEOUT)
+    .await
+    .expect("message not received in time")
+}
+
+/// Sizes around every boundary the receive path cares about: short/long ZMTP frames, the
+/// provided-buffer slot size (~64 KiB), the direct threshold (32 KiB), typical large
+/// messages, and above the 16 MiB preallocation cap (buffer grows as data arrives).
+const SIZES: &[usize] = &[
+  0,
+  1,
+  255,
+  256,
+  4096,
+  16 << 10,
+  (32 << 10) - 1,
+  32 << 10,
+  (32 << 10) + 1,
+  64 << 10,
+  100 << 10,
+  256 << 10,
+  1 << 20,
+  3 << 20,
+  7,
+  (1 << 20) + 13,
+  (17 << 20) + 5,
+  9,
+  512 << 10,
+];
+
+async fn stream_sizes(direct_threshold: Option<i32>) {
+  let ctx = common::test_context();
+  let pull = uring_socket(&ctx, SocketType::Pull, direct_threshold).await;
+  pull.bind("tcp://127.0.0.1:0").await.unwrap();
+  let ep = endpoint_of(&pull).await;
+  let push = uring_socket(&ctx, SocketType::Push, None).await;
+  push.connect(&ep).await.unwrap();
+
+  let rounds = 3u32;
+  let sender = tokio::spawn({
+    let push = push.clone();
+    async move {
+      for round in 0..rounds {
+        for (i, &len) in SIZES.iter().enumerate() {
+          let seq = round * 1000 + i as u32;
+          push.send(Msg::from_vec(payload(seq, len))).await?;
+        }
+      }
+      Ok::<(), ZmqError>(())
+    }
+  });
+  for round in 0..rounds {
+    for (i, &len) in SIZES.iter().enumerate() {
+      let seq = round * 1000 + i as u32;
+      let msg = recv(&pull).await;
+      let data = msg.data().unwrap_or(&[]);
+      assert_eq!(data.len(), len, "message {seq}: wrong length");
+      assert!(data == payload(seq, len).as_slice(), "message {seq} ({len} bytes): wrong bytes");
+    }
+  }
+  sender.await.unwrap().unwrap();
+  ctx.term().await.unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn direct_recv_mixed_sizes() {
+  if !init_uring() {
+    return;
+  }
+  stream_sizes(None).await; // default threshold (direct receive on)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn direct_recv_low_threshold() {
+  if !init_uring() {
+    return;
+  }
+  stream_sizes(Some(1)).await; // every partial frame goes direct
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn direct_recv_disabled() {
+  if !init_uring() {
+    return;
+  }
+  stream_sizes(Some(0)).await; // provided-buffer path only
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn direct_recv_multipart_topic_and_large_body() {
+  if !init_uring() {
+    return;
+  }
+  let ctx = common::test_context();
+  let sub = uring_socket(&ctx, SocketType::Sub, None).await;
+  sub.set_option_raw(SUBSCRIBE, b"topic").await.unwrap();
+  sub.bind("tcp://127.0.0.1:0").await.unwrap();
+  let ep = endpoint_of(&sub).await;
+  let publ = uring_socket(&ctx, SocketType::Pub, None).await;
+  publ.connect(&ep).await.unwrap();
+  tokio::time::sleep(Duration::from_millis(300)).await; // subscription reaches the PUB
+
+  let bodies: Vec<usize> = vec![1 << 20, 300, 256 << 10, 5, (2 << 20) + 1, 100 << 10, 0, 1 << 20];
+  let sender = tokio::spawn({
+    let publ = publ.clone();
+    let bodies = bodies.clone();
+    async move {
+      for (seq, &len) in bodies.iter().enumerate() {
+        let mut topic = Msg::from_vec(format!("topic-{seq}").into_bytes());
+        topic.set_flags(MsgFlags::MORE);
+        publ
+          .send_multipart(vec![topic, Msg::from_vec(payload(seq as u32, len))])
+          .await?;
+      }
+      Ok::<(), ZmqError>(())
+    }
+  });
+  for (seq, &len) in bodies.iter().enumerate() {
+    let topic = recv(&sub).await;
+    assert_eq!(topic.data().unwrap_or(&[]), format!("topic-{seq}").as_bytes());
+    assert!(topic.is_more(), "topic frame {seq} lost its MORE flag");
+    let body = recv(&sub).await;
+    assert!(!body.is_more());
+    assert!(
+      body.data().unwrap_or(&[]) == payload(seq as u32, len).as_slice(),
+      "body {seq} ({len} bytes): wrong bytes"
+    );
+  }
+  sender.await.unwrap().unwrap();
+  ctx.term().await.unwrap();
+}
+
+/// Minimal raw ZMTP 3.1 peer (NULL mechanism) acting as a PUSH socket.
+fn raw_push_handshake(ep: &str) -> TcpStream {
+  let addr = ep.trim_start_matches("tcp://");
+  let mut s = TcpStream::connect(addr).unwrap();
+  s.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+  let mut greeting = vec![0xFF, 0, 0, 0, 0, 0, 0, 0, 0, 0x7F, 3, 1];
+  greeting.extend_from_slice(b"NULL");
+  greeting.resize(64, 0);
+  s.write_all(&greeting).unwrap();
+  let mut peer_greeting = [0u8; 64];
+  s.read_exact(&mut peer_greeting).unwrap();
+  let mut body = vec![5u8];
+  body.extend_from_slice(b"READY");
+  body.push(11);
+  body.extend_from_slice(b"Socket-Type");
+  body.extend_from_slice(&4u32.to_be_bytes());
+  body.extend_from_slice(b"PUSH");
+  let mut ready = vec![0x04, body.len() as u8];
+  ready.extend_from_slice(&body);
+  s.write_all(&ready).unwrap();
+  let mut hdr = [0u8; 2];
+  s.read_exact(&mut hdr).unwrap(); // peer READY (short command)
+  let mut rest = vec![0u8; hdr[1] as usize];
+  s.read_exact(&mut rest).unwrap();
+  s
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[serial]
+async fn direct_recv_peer_vanishes_mid_frame() {
+  if !init_uring() {
+    return;
+  }
+  let ctx = common::test_context();
+  let pull = uring_socket(&ctx, SocketType::Pull, None).await;
+  pull.bind("tcp://127.0.0.1:0").await.unwrap();
+  let ep = endpoint_of(&pull).await;
+
+  for round in 0..40u32 {
+    // A peer announces a large frame (sometimes absurdly large), sends part of the body
+    // so the receiver is waiting in a direct receive, then disappears (FIN or RST).
+    let ep_raw = ep.clone();
+    tokio::task::spawn_blocking(move || {
+      let mut s = raw_push_handshake(&ep_raw);
+      let declared: u64 = if round % 5 == 0 { 1 << 44 } else { (2 << 20) + u64::from(round) };
+      let mut frame = vec![0x02];
+      frame.extend_from_slice(&declared.to_be_bytes());
+      s.write_all(&frame).unwrap();
+      s.write_all(&vec![0xAB; 100 << 10]).unwrap();
+      std::thread::sleep(Duration::from_millis(20));
+      if round % 2 == 0 {
+        let sock = socket2::SockRef::from(&s);
+        sock.set_linger(Some(Duration::ZERO)).unwrap(); // RST on close
+      }
+    })
+    .await
+    .unwrap();
+
+    // A well-behaved peer right after (likely reusing the fd number): its large messages
+    // must arrive intact. The first switches its connection to direct receive; the later
+    // ones are received directly into their buffers.
+    let push = uring_socket(&ctx, SocketType::Push, None).await;
+    push.connect(&ep).await.unwrap();
+    for i in 0..3u32 {
+      let seq = round * 10 + i;
+      let len = (1 << 20) + seq as usize;
+      push.send(Msg::from_vec(payload(seq, len))).await.unwrap();
+      let msg = recv(&pull).await;
+      assert!(
+        msg.data().unwrap_or(&[]) == payload(seq, len).as_slice(),
+        "round {round} message {i}: wrong bytes after a mid-frame disconnect"
+      );
+    }
+    push.close().await.unwrap();
+  }
+  ctx.term().await.unwrap();
+}
